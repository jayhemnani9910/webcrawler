# Every variable is optional. Copy to .env and fill in what you need.

# Where the SQLite database, keys, local anchor files and logs go.
WPS_DB_PATH=./watcher.db
WPS_KEYS_DIR=./keys
WPS_ANCHOR_DIR=./anchors
WPS_LOG_DIR=./logs

# Token for the /admin/* routes. They answer 503 while this is unset.
WPS_ADMIN_TOKEN=

# Read a pre-built ArchiveBox index instead of calling `archivebox list --json`.
ARCHIVEBOX_INDEX_JSON=

# OpenTimestamps server. Without it, or the `ots` CLI, anchors are local files.
OTSD_URL=

# Sign with AWS KMS (needs boto3) or Vault (needs hvac) instead of local keys.
WPS_KMS_KEY_ID=
AWS_KMS_KEY_ID=
VAULT_ADDR=
VAULT_TOKEN=
